--<%= getCommentPrefixing(`rpc ${name}(`) %>
  public <%= lowerFirst(name) %>(<%= req.empty ? '' : `req: ${requestTsType}, ` %>options?: grpc.CallOptions): Promise<<%= responseTsType %>> {
    return this.client.exec('<%= service %>', '<%= lowerFirst(name) %>', <%= req.empty ? '{}' : 'req' %>, options);
  }
