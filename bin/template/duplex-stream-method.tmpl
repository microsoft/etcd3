--<%= getCommentPrefixing(`rpc ${name}(`) %>
  public <%= lowerFirst(name) %>(options?: grpc.CallOptions): Promise<IDuplexStream<<%= requestTsType %>, <%= responseTsType %>>> {
    return this.client.withConnection('<%= service %>', ({ resource, client, metadata }) => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const resolved = resolveCallOptions(options, this.client.callOptionsFactory, {
          service: '<%= service %>',
          method: '<%= lowerFirst(name) %>',
          isStream: true,
        });
        const stream = (<any> client).<%= lowerFirst(name) %>(metadata, resolved);
        return monitorResponseStream(this.client, resource, stream);
      });
  }
