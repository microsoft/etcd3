{
  "name": "etcd3",
  "version": "2.0.0",
  "description": "Node client for etcd3",
  "type": "module",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "proto"
  ],
  "scripts": {
    "test": "npm run test:lint && npm run test:typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:cover": "vitest run --coverage",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "test:lint": "eslint \"src/**/*.ts\"",
    "watch": "tsc --watch",
    "build:proto": "node ./bin/update-proto ./proto && node bin/generate-methods.js ./proto/rpc.proto",
    "build:doc": "rimraf docs && typedoc --options typedoc.json && node bin/tame-typedoc",
    "build:ts": "rimraf lib && tsc",
    "fmt": "prettier --write \"src/**/*.{ts,js}\" && npm run -s test:lint -- --fix",
    "prepare": "npm run -s build:ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/etcd3.git"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "etcd3",
    "etcd",
    "node",
    "client",
    "protobuf",
    "proto"
  ],
  "author": "Connor Peet <connor@peet.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microsoft/etcd3/issues"
  },
  "homepage": "https://github.com/microsoft/etcd3#readme",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "protobufjs": "^8.8.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "cockatiel": "^4.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "arrowParens": "avoid"
  }
}
