{
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "rootDir": "src",
    "outDir": "lib",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/test"]
}
